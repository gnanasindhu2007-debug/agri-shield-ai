{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/Frontend/index.html"
    },
    {
      "source": "/upload",
      "destination": "/Frontend/upload.html"
    },
    {
      "source": "/upload.html",
      "destination": "/Frontend/upload.html"
    },
    {
      "source": "/result",
      "destination": "/Frontend/result.html"
    },
    {
      "source": "/result.html",
      "destination": "/Frontend/result.html"
    }
  ]
}
